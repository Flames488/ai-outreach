# ===========================
# PROJECT
# ===========================
APP_NAME=Flames
APP_ENV=development
DEBUG=true
SECRET_KEY=
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
# Comma-separated; "*" (dev default) disables the allowlist.
ALLOWED_HOSTS=*
# Comma-separated; "*" (dev default). In production set this to the
# dashboard's real origin(s), e.g. https://flames.example.com.
CORS_ALLOWED_ORIGINS=*
# Where the dashboard is served. Optional — only used to redirect the
# browser back there after the Gmail OAuth consent flow; leave blank and
# that flow returns its JSON envelope directly instead.
FRONTEND_URL=

# ===========================
# DATABASE
# ===========================
POSTGRES_DB=flames
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Leave blank to auto-derive from the POSTGRES_* values above.
DATABASE_URL=

# ===========================
# REDIS
# ===========================
REDIS_URL=redis://redis:6379/0

# ===========================
# TELEGRAM
# ===========================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# ===========================
# AI PROVIDER (groq | deepseek — both OpenAI-compatible)
# ===========================
AI_PROVIDER=groq
AI_RATE_LIMIT_PER_MINUTE=25

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ===========================
# GMAIL / GOOGLE OAUTH
# ===========================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=
GOOGLE_PROJECT_ID=
GMAIL_ADDRESS=emmanuelnwobodo38@gmail.com
GMAIL_SYNC_INTERVAL=300
ENABLE_ATTACHMENT_DOWNLOAD=false
MAX_ATTACHMENT_SIZE_MB=25

# ===========================
# ENCRYPTION
# ===========================
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=

# ===========================
# SEED (initial admin user — scripts/seed.py only, not used by ongoing login)
# ===========================
SEED_ADMIN_EMAIL=admin@flames.local
SEED_ADMIN_PASSWORD=

# ===========================
# JOB SEARCH
# ===========================
JOB_SEARCH_TIME_MORNING=07:00
JOB_SEARCH_TIME_AFTERNOON=12:00
JOB_SEARCH_TIME_EVENING=19:00
JOB_SEARCH_MAX_RESULTS=200
JOB_MATCH_THRESHOLD=80

# ===========================
# STORAGE (consolidated under one root — Part 10 §152)
# ===========================
STORAGE_ROOT=/app/storage
LOG_DIR=/app/logs

# ===========================
# PLAYWRIGHT (Phase 3 — dry-run application engine)
# ===========================
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_SLOWMO_MS=0
PLAYWRIGHT_SCREENSHOT_DIR=/app/storage/screenshots

# ===========================
# FEATURE FLAGS (consolidated list — Part 10 §155)
# ===========================
ENABLE_PLAYWRIGHT=false
ENABLE_GMAIL=true
ENABLE_TELEGRAM=true
ENABLE_AI_SCORING=true
ENABLE_AUTO_APPLY=false
ENABLE_DASHBOARD=false
ENABLE_SCREENSHOTS=false
ENABLE_RESUME_GENERATOR=false
ENABLE_INTERVIEW_PREPARATION=false

# ===========================
# CELERY / MONITORING
# ===========================
FLOWER_PORT=5555

# ===========================
# FRONTEND
# ===========================
VITE_API_BASE_URL=/api/v1
